#define VER_FILEVERSION             @PSRPT_VERSION_MAJOR@,@PSRPT_VERSION_MINOR@,@PSRPT_VERSION_PATCH@,0
#define VER_FILEVERSION_STR         "@PSRPT_VERSION_MAJOR@.@PSRPT_VERSION_MINOR@.@PSRPT_VERSION_PATCH@.0\0"

#define VER_PRODUCTVERSION          @PSRPT_VERSION_MAJOR@,@PSRPT_VERSION_MINOR@,@PSRPT_VERSION_PATCH@,0
#define VER_PRODUCTVERSION_STR      "@PSRPT_VERSION_MAJOR@.@PSRPT_VERSION_MINOR@.@PSRPT_VERSION_PATCH@.0\0"

1 VERSIONINFO
 FILEVERSION VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "Comments", "Play together on one PlayStation: shared Remote Play, built on chiaki-ng"
            VALUE "CompanyName", "GamerNova.net"
            VALUE "FileDescription", "PSRemotePlayTogether"
            VALUE "FileVersion", VER_FILEVERSION_STR
            VALUE "InternalName", "PSRemotePlayTogether"
            VALUE "LegalCopyright", "AGPLv3. GamerNova.net; chiaki-ng by Street Pea; Chiaki by Florian Markl"
            VALUE "OriginalFilename", "PSRemotePlayTogether.exe"
            VALUE "ProductName", "PSRemotePlayTogether"
            VALUE "ProductVersion", VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
IDI_ICON1 ICON DISCARDABLE "chiaking.ico"